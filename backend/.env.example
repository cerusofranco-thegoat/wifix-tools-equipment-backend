# Entorno de ejecución (development | production)
NODE_ENV=development

# Puerto HTTP del servidor Fastify
PORT=8080

# Cadena de conexión PostgreSQL
DATABASE_URL=postgresql://wifix:wifix@localhost:5433/wifix_tools?schema=public

# Autenticación (Fase 2)
JWT_SECRET=cambia-este-secreto-en-prod-min-32-caracteres-y-bien-aleatorio
JWT_EXPIRES_IN=12h
SEED_USER_EMAIL=franco@tulpasolutions.com
SEED_USER_PASSWORD=wifix-dev-2026
SEED_USER_NAME=Franco Ceruso

# Capa de conectores externos: mock | real
CONNECTOR_MODE=mock

# Almacenamiento S3-compatible (MinIO en local)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=wifix-media
STORAGE_ACCESS_KEY=wifixminio
STORAGE_SECRET_KEY=wifixminio123

# Nivel de log de pino (trace | debug | info | warn | error | fatal)
LOG_LEVEL=info

# Origen permitido para CORS desde el frontend wifix-webapp
CORS_ORIGIN=http://localhost:5173

# --- Jitsi Meet self-host (Fase D) ---
# Dominio del servidor Jitsi (coincide con JITSI_SUB en producción)
JITSI_DOMAIN=meet.wifix.internal
# App ID registrado en el servidor Jitsi (issuer del JWT)
JITSI_APP_ID=wifix
# Sub del JWT de sala Jitsi (generalmente el dominio del Jitsi)
JITSI_SUB=meet.wifix.internal
# Secreto compartido con el servidor Jitsi para firmar JWTs de sala (mínimo 32 chars)
JITSI_APP_SECRET=cambia-este-secreto-jitsi-en-prod-min-32-caracteres
# TTL en segundos del JWT de sala Jitsi (default: 1800 = 30 min; se renueva al re-unirse)
JITSI_JWT_TTL=1800

# --- Broker WSS sesión remota (Fase D) ---
# Secreto para firmar tokens de sesión remota del broker (distinto de JWT_SECRET, mínimo 32 chars)
BROKER_TOKEN_SECRET=cambia-este-secreto-broker-en-prod-min-32-caracteres
# TTL por defecto de sesión remota si el cliente no especifica ttlSeconds (segundos)
BROKER_DEFAULT_TTL_SECONDS=600
# Habilitar grabación de sesiones remotas a MediaFile (true | false)
BROKER_RECORDING_ENABLED=false
# URL pública del endpoint WSS del broker entregada al agente en OpenRemoteSession (B-3).
# En producción: wss://<dominio-publico>/asistencia/v1/broker/connect
# En desarrollo: ws://localhost:8080/asistencia/v1/broker/connect (default)
BROKER_PUBLIC_WS_URL=ws://localhost:8080/asistencia/v1/broker/connect

# --- Rate-limiting del broker (Fase D hardening) ---
# Máx. peticiones de apertura de sesión remota (POST /sessions/:id/remote-sessions) por IP por ventana.
# Default: 10 req / 60 000 ms (1 minuto)
BROKER_RATE_LIMIT_MAX=10
# Ventana de tiempo en ms para el rate-limit de emisión de tokens (y WS del broker).
BROKER_RATE_LIMIT_WINDOW_MS=60000
# Máx. conexiones WS del broker (agente + túnel) por IP por ventana.
# Default: 30 / 60 000 ms
BROKER_WS_RATE_LIMIT_MAX=30
