// Esquema Prisma — Módulo Herramientas y Equipos Retirados (Wifix Fase 1).
// Tablas y columnas en snake_case; campos del cliente Prisma en camelCase
// (mapeo con @map / @@map). Identificadores propios: uuid v4.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = []
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===========================================================================
// USUARIOS (Fase 2 — autenticación; rol añadido en Fase 0 de Asistencia)
// ===========================================================================

enum UserRole {
  TECHNICIAN
  AGENT
  SUPERVISOR

  @@map("user_role")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  role         UserRole @default(TECHNICIAN)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("users")
}

// ===========================================================================
// ENUMS
// ===========================================================================

enum EquipmentCategory {
  DECODIFICADOR
  DECODIFICADOR_HD
  MTA
  ONU
  ONT
  ROUTER

  @@map("equipment_category")
}

enum EquipmentSerialFieldType {
  SN
  HOST_SN @map("HOST-SN")
  PON_SN  @map("PON-SN")
  GPON_SN @map("GPON-SN")
  D_SN    @map("D-SN")

  @@map("equipment_serial_field_type")
}

enum RemovalReasonCode {
  DANO_FISICO
  NO_ENCIENDE
  PUERTO_DANADO
  EQUIPO_INHIBIDO
  NO_DA_SERVICIO
  NO_SE_APROVISIONA
  EQUIPO_OK_CANCELACION
  OTROS

  @@map("removal_reason_code")
}

enum NetworkServerType {
  DNS
  GATEWAY
  CDN
  GENERIC

  @@map("network_server_type")
}

// ===========================================================================
// CATÁLOGOS
// ===========================================================================

model EquipmentModel {
  id              String                   @id @default(uuid()) @db.Uuid
  name            String
  category        EquipmentCategory
  serialFieldType EquipmentSerialFieldType @map("serial_field_type")
  brand           String?
  active          Boolean                  @default(true)

  retiredEquipment RetiredEquipment[]

  @@map("equipment_models")
}

model RemovalReason {
  code      RemovalReasonCode @id
  label     String
  sortOrder Int               @default(0) @map("sort_order")
  active    Boolean           @default(true)

  retiredEquipment RetiredEquipment[]

  @@map("removal_reasons")
}

model SpeedtestServer {
  id        String  @id @default(uuid()) @db.Uuid
  name      String
  host      String
  city      String?
  latitude  Float?
  longitude Float?
  active    Boolean @default(true)

  @@map("speedtest_servers")
}

model NetworkServer {
  id     String            @id @default(uuid()) @db.Uuid
  name   String
  target String
  type   NetworkServerType
  active Boolean           @default(true)

  @@map("network_servers")
}

// ===========================================================================
// MEDIA
// ===========================================================================

model MediaFile {
  id          String   @id @default(uuid()) @db.Uuid
  storageKey  String   @map("storage_key")
  url         String
  contentType String   @map("content_type")
  sizeBytes   Int      @map("size_bytes")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  retiredEquipment        RetiredEquipment[]
  remoteSessionRecordings RemoteSession[]    @relation("RemoteSessionRecording")

  @@map("media_files")
}

// ===========================================================================
// TRANSACCIONALES — HERRAMIENTAS
// ===========================================================================

model DistanceMeasurement {
  id             String   @id @default(uuid()) @db.Uuid
  accountNumber  String   @map("account_number")
  clientId       String?  @map("client_id")
  contractId     String?  @map("contract_id")
  visitId        String?  @map("visit_id")
  technicianId   String?  @map("technician_id")
  distanceMeters Float    @map("distance_meters")
  startLat       Float?   @map("start_lat")
  startLng       Float?   @map("start_lng")
  endLat         Float?   @map("end_lat")
  endLng         Float?   @map("end_lng")
  measuredAt     DateTime @map("measured_at") @db.Timestamptz(6)
  notes          String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([accountNumber])
  @@index([clientId])
  @@index([visitId])
  @@index([measuredAt])
  @@map("distance_measurements")
}

model Speedtest {
  id                String   @id @default(uuid()) @db.Uuid
  accountNumber     String   @map("account_number")
  clientId          String?  @map("client_id")
  contractId        String?  @map("contract_id")
  visitId           String?  @map("visit_id")
  technicianId      String?  @map("technician_id")
  downloadMbps      Float    @map("download_mbps")
  uploadMbps        Float    @map("upload_mbps")
  latencyMs         Float?   @map("latency_ms")
  jitterMs          Float?   @map("jitter_ms")
  packetLossPercent Float?   @map("packet_loss_percent")
  serverId          String?  @map("server_id")
  serverName        String?  @map("server_name")
  ispName           String?  @map("isp_name")
  measuredAt        DateTime @map("measured_at") @db.Timestamptz(6)
  notes             String?
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([accountNumber])
  @@index([clientId])
  @@index([visitId])
  @@index([measuredAt])
  @@map("speedtests")
}

model WifiHeatmap {
  id            String   @id @default(uuid()) @db.Uuid
  accountNumber String   @map("account_number")
  clientId      String?  @map("client_id")
  contractId    String?  @map("contract_id")
  visitId       String?  @map("visit_id")
  technicianId  String?  @map("technician_id")
  label         String?
  notes         String?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  rooms     WifiHeatmapRoom[]
  pingTests PingTest[]

  @@index([accountNumber])
  @@index([clientId])
  @@index([visitId])
  @@index([createdAt])
  @@map("wifi_heatmaps")
}

model WifiHeatmapRoom {
  id           String   @id @default(uuid()) @db.Uuid
  heatmapId    String   @map("heatmap_id") @db.Uuid
  roomName     String   @map("room_name")
  floor        Int      @default(1)
  /// Deprecated. Para multi-AP cada room tiene N entradas en `measurements`.
  /// Sigue presente para retrocompatibilidad de lectura. En lecturas nuevas
  /// el valor "efectivo" es el mejor signalDbm de `measurements`.
  signalDbm    Float?   @map("signal_dbm")
  legacyFormat Boolean  @default(false) @map("legacy_format")
  measuredAt   DateTime @map("measured_at") @db.Timestamptz(6)
  notes        String?

  heatmap      WifiHeatmap         @relation(fields: [heatmapId], references: [id], onDelete: Cascade)
  measurements RoomApMeasurement[]

  @@index([heatmapId])
  @@map("wifi_heatmap_rooms")
}

model WifiAccessPoint {
  id            String   @id @default(uuid()) @db.Uuid
  accountNumber String   @map("account_number")
  bssid         String
  ssid          String?
  label         String
  /// "router" | "extender" | "mesh_node" | "unknown"
  apType        String   @default("unknown") @map("ap_type")
  /// "2.4GHz" | "5GHz" | "6GHz" | "unknown"
  band          String   @default("unknown")
  notes         String?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  measurements RoomApMeasurement[]

  @@unique([accountNumber, bssid])
  @@index([accountNumber])
  @@map("wifi_access_points")
}

model RoomApMeasurement {
  id              String   @id @default(uuid()) @db.Uuid
  roomId          String   @map("room_id") @db.Uuid
  accessPointId   String?  @map("access_point_id") @db.Uuid
  bssid           String
  apLabelSnapshot String?  @map("ap_label_snapshot")
  signalDbm       Float    @map("signal_dbm")
  /// "2.4GHz" | "5GHz" | "6GHz" | "unknown"
  band            String   @default("unknown")
  channel         Int?
  isConnected     Boolean  @default(false) @map("is_connected")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  room        WifiHeatmapRoom  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  accessPoint WifiAccessPoint? @relation(fields: [accessPointId], references: [id], onDelete: SetNull)

  @@index([roomId])
  @@index([accessPointId])
  @@index([bssid])
  @@map("room_ap_measurements")
}

model PingTest {
  id                String   @id @default(uuid()) @db.Uuid
  accountNumber     String   @map("account_number")
  clientId          String?  @map("client_id")
  contractId        String?  @map("contract_id")
  visitId           String?  @map("visit_id")
  technicianId      String?  @map("technician_id")
  target            String
  serverId          String?  @map("server_id")
  packetsSent       Int?     @map("packets_sent")
  packetsReceived   Int?     @map("packets_received")
  packetLossPercent Float?   @map("packet_loss_percent")
  minLatencyMs      Float?   @map("min_latency_ms")
  avgLatencyMs      Float?   @map("avg_latency_ms")
  maxLatencyMs      Float?   @map("max_latency_ms")
  continuous        Boolean  @default(false)
  heatmapId         String?  @map("heatmap_id") @db.Uuid
  roomName          String?  @map("room_name")
  measuredAt        DateTime @map("measured_at") @db.Timestamptz(6)
  notes             String?
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  heatmap WifiHeatmap? @relation(fields: [heatmapId], references: [id], onDelete: SetNull)

  @@index([accountNumber])
  @@index([clientId])
  @@index([visitId])
  @@index([measuredAt])
  @@index([heatmapId])
  @@map("ping_tests")
}

model TracerouteTest {
  id            String   @id @default(uuid()) @db.Uuid
  accountNumber String   @map("account_number")
  clientId      String?  @map("client_id")
  contractId    String?  @map("contract_id")
  visitId       String?  @map("visit_id")
  technicianId  String?  @map("technician_id")
  target        String
  serverId      String?  @map("server_id")
  measuredAt    DateTime @map("measured_at") @db.Timestamptz(6)
  notes         String?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  hops TracerouteHop[]

  @@index([accountNumber])
  @@index([clientId])
  @@index([visitId])
  @@index([measuredAt])
  @@map("traceroute_tests")
}

model TracerouteHop {
  id               String  @id @default(uuid()) @db.Uuid
  tracerouteTestId String  @map("traceroute_test_id") @db.Uuid
  hopNumber        Int     @map("hop_number")
  host             String?
  latencyMs        Float?  @map("latency_ms")

  tracerouteTest TracerouteTest @relation(fields: [tracerouteTestId], references: [id], onDelete: Cascade)

  @@index([tracerouteTestId])
  @@map("traceroute_hops")
}

// ===========================================================================
// TRANSACCIONALES — EQUIPOS RETIRADOS
// ===========================================================================

model RetiredEquipment {
  id                String                   @id @default(uuid()) @db.Uuid
  accountNumber     String                   @map("account_number")
  clientId          String?                  @map("client_id")
  contractId        String?                  @map("contract_id")
  visitId           String?                  @map("visit_id")
  technicianId      String?                  @map("technician_id")
  equipmentModelId  String                   @map("equipment_model_id") @db.Uuid
  serialValue       String                   @map("serial_value")
  serialFieldType   EquipmentSerialFieldType @map("serial_field_type")
  barcodePhotoId    String?                  @map("barcode_photo_id") @db.Uuid
  removalReasonCode RemovalReasonCode        @map("removal_reason_code")
  observations      String?
  retiredAt         DateTime                 @map("retired_at") @db.Timestamptz(6)
  createdAt         DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)

  equipmentModel EquipmentModel @relation(fields: [equipmentModelId], references: [id])
  removalReason  RemovalReason  @relation(fields: [removalReasonCode], references: [code])
  barcodePhoto   MediaFile?     @relation(fields: [barcodePhotoId], references: [id], onDelete: SetNull)

  @@index([accountNumber])
  @@index([clientId])
  @@index([visitId])
  @@index([serialValue])
  @@index([retiredAt])
  @@map("retired_equipment")
}

// ===========================================================================
// MÓDULO ASISTENCIA TÉCNICA (Fase 0)
// Fusionado desde wifix_asistencia_tecnica.prisma
// ===========================================================================

enum AssistanceStatus {
  REQUESTED
  QUEUED
  ASSIGNED
  ACTIVE
  ON_HOLD
  RESOLVED
  UNRESOLVED
  CANCELLED
  EXPIRED

  @@map("assistance_status")
}

enum AssistanceEventType {
  STATE_CHANGE
  NOTE
  ACTION
  REMOTE_SESSION
  CHAT
  CONSENT

  @@map("assistance_event_type")
}

enum RemoteActionType {
  REBOOT
  SET_WIFI
  SET_CHANNEL
  FACTORY_RESET
  REPROVISION
  RUN_DIAGNOSTIC

  @@map("remote_action_type")
}

enum RemoteActionStatus {
  PENDING
  SUCCESS
  FAILED

  @@map("remote_action_status")
}

enum RemoteSessionChannel {
  BROKER_TUNNEL
  COBROWSE

  @@map("remote_session_channel")
}

enum RemoteSessionStatus {
  OPEN
  CLOSED
  EXPIRED

  @@map("remote_session_status")
}

model AssistanceSession {
  id             String           @id @default(uuid()) @db.Uuid
  accountNumber  String           @map("account_number")
  visitId        String?          @map("visit_id")
  technicianId   String?          @map("technician_id")
  agentId        String?          @map("agent_id")
  status         AssistanceStatus @default(REQUESTED)
  reason         String?
  consentAt      DateTime?        @map("consent_at") @db.Timestamptz(6)
  requestedAt    DateTime         @default(now()) @map("requested_at") @db.Timestamptz(6)
  closedAt       DateTime?        @map("closed_at") @db.Timestamptz(6)
  resolutionNote String?          @map("resolution_note")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  events         AssistanceEvent[]
  remoteActions  RemoteAction[]
  remoteSessions RemoteSession[]

  @@index([accountNumber])
  @@index([status])
  @@index([requestedAt])
  @@index([agentId])
  @@map("assistance_sessions")
}

model AssistanceEvent {
  id        String              @id @default(uuid()) @db.Uuid
  sessionId String              @map("session_id") @db.Uuid
  type      AssistanceEventType
  payload   Json?
  actorId   String?             @map("actor_id")
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  session AssistanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([createdAt])
  @@map("assistance_events")
}

model RemoteAction {
  id            String             @id @default(uuid()) @db.Uuid
  sessionId     String             @map("session_id") @db.Uuid
  accountNumber String             @map("account_number")
  action        RemoteActionType
  status        RemoteActionStatus @default(PENDING)
  request       Json?
  result        Json?
  performedBy   String?            @map("performed_by")
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  session AssistanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([accountNumber])
  @@index([status])
  @@map("remote_actions")
}

model RemoteSession {
  id          String               @id @default(uuid()) @db.Uuid
  sessionId   String               @map("session_id") @db.Uuid
  channel     RemoteSessionChannel
  status      RemoteSessionStatus  @default(OPEN)
  targetHost  String?              @map("target_host")
  expiresAt   DateTime             @map("expires_at") @db.Timestamptz(6)
  recordingId String?              @map("recording_id") @db.Uuid
  startedAt   DateTime             @default(now()) @map("started_at") @db.Timestamptz(6)
  endedAt     DateTime?            @map("ended_at") @db.Timestamptz(6)

  session   AssistanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  recording MediaFile?        @relation("RemoteSessionRecording", fields: [recordingId], references: [id], onDelete: SetNull)

  @@index([sessionId])
  @@index([status])
  @@map("remote_sessions")
}

// Auditoría de llamadas a sistemas externos (ADR-0005). Una fila por llamada.
model ConnectorCallLog {
  id            String   @id @default(uuid()) @db.Uuid
  connector     String
  operation     String
  accountNumber String?  @map("account_number")
  status        Int?
  request       Json?
  response      Json?
  durationMs    Int?     @map("duration_ms")
  actorId       String?  @map("actor_id")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([connector])
  @@index([accountNumber])
  @@index([createdAt])
  @@map("connector_call_logs")
}

// Archivo del histórico del backend mirror de Wifi Monitor (ADR-0006).
// Solo si existe volumen real; importación única.
model LegacyScan {
  id            String   @id @default(uuid()) @db.Uuid
  legacyId      String?  @map("legacy_id")
  scanCode      String?  @map("scan_code")
  accountNumber String?  @map("account_number")
  ssid          String?
  bssid         String?
  downloadMbps  Float?   @map("download_mbps")
  uploadMbps    Float?   @map("upload_mbps")
  signalDbm     Int?     @map("signal_dbm")
  payload       Json
  capturedAt    DateTime @map("captured_at") @db.Timestamptz(6)
  importedAt    DateTime @default(now()) @map("imported_at") @db.Timestamptz(6)

  @@unique([legacyId])
  @@index([accountNumber])
  @@index([capturedAt])
  @@map("legacy_scans")
}
