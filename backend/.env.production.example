# ===========================================================================
# Wifix Certificate — backend en un VPS (plantilla de .env de PRODUCCION/DEMO)
#
#   cp .env.production.example .env     y rellenar lo marcado con <>
#
# NINGUN valor real vive en este archivo: es plantilla y se commitea.
# El `.env` del servidor NO se commitea (esta en .gitignore).
#
# Las claves que usa docker-compose.prod.yml directamente (no solo el backend)
# estan marcadas con [compose].
# ===========================================================================

# --- Entorno ---------------------------------------------------------------
NODE_ENV=production
PORT=8080

# --- Base de datos ---------------------------------------------------------
# [compose] Credenciales del contenedor de Postgres.
POSTGRES_USER=wifix
POSTGRES_PASSWORD=<contraseña-aleatoria-larga>
POSTGRES_DB=wifix_tools
# El host es el NOMBRE DEL SERVICIO de compose, no localhost: los contenedores
# se ven entre si por la red `wifix`. Debe coincidir con las tres de arriba.
DATABASE_URL=postgresql://wifix:<contraseña-aleatoria-larga>@postgres:5432/wifix_tools?schema=public

# --- Autenticacion ---------------------------------------------------------
# Minimo 32 caracteres aleatorios. Con el valor por defecto del codigo el
# servidor se NIEGA a arrancar si NODE_ENV=production (es a proposito).
#   openssl rand -base64 48
JWT_SECRET=<secreto-aleatorio-min-32-caracteres>
JWT_EXPIRES_IN=12h
# Usuario que siembra `prisma/seed.ts`. Para la demo conviene uno propio.
SEED_USER_EMAIL=<usuario@tulpasolutions.com>
SEED_USER_PASSWORD=<contraseña-de-la-demo>
SEED_USER_NAME=<Nombre Apellido>

# Usuario admin adicional de `prisma/create-admin.ts` (OPCIONAL: el de
# SEED_USER_* ya alcanza). En produccion ese script ABORTA si no estan definidas:
# no crea ningun usuario con credenciales del repositorio. Se pueden pasar en la
# linea del `docker compose run` en vez de dejarlas en el .env.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_NAME=

# ===========================================================================
# CONECTORES — configuracion de la DEMO
# ===========================================================================
# Modo global: todo simulado salvo lo que se habilite explicitamente abajo.
# Nunca poner `real` aca: Comarch, ACS y RMS solo tienen esqueleto y
# responderian 502 (por eso cada conector tiene su propio override).
CONNECTOR_MODE=mock

# FSM (ordenes, tareas, NAPs GPON, estado de cuenta):
#   fixture → respuestas REALES grabadas de la cuenta 35070291, sin red.
#             Es el modo de la demo: no depende del token de 24 h ni de la IP.
#             Cualquier otra cuenta sigue respondiendo con datos simulados.
#   real    → API de la operadora (apix.grupotvcable.com). Requiere IP
#             autorizada + token/key vigentes (bloque FSM mas abajo).
#   mock    → todo sembrado.
CONNECTOR_MODE_FSM=fixture

# TEC e ISP Monitor viven en tec-api.grupotvcable.com, que esta BLOQUEADO desde
# el VPS Quasar (203.161.49.68). En el VPS van en mock; solo pasarlos a `real`
# cuando la operadora habilite la IP.
CONNECTOR_MODE_TEC=mock
CONNECTOR_MODE_ISPMONITOR=mock

# Sin credenciales todavia: se quedan en mock aunque cambie el global.
CONNECTOR_MODE_COMARCH=mock
CONNECTOR_MODE_ACS=mock
CONNECTOR_MODE_RMS=mock

# --- API de TEC / ISP Monitor (Grupo TVCable) ------------------------------
# Solo se usan con CONNECTOR_MODE_TEC/_ISPMONITOR=real (y entonces son
# OBLIGATORIAS: sin ellas el servidor no arranca). Autenticacion HTTP Digest.
TEC_API_BASE_URL=https://tec-api.grupotvcable.com
TEC_API_USERNAME=
TEC_API_PASSWORD=
TEC_API_TIMEOUT_MS=15000
TEC_API_MAX_CONCURRENCY=4
TEC_API_CACHE_TTL_MS=60000

# --- FSM (fsm-data-ms, Grupo TVCable) --------------------------------------
# Con CONNECTOR_MODE_FSM=fixture NADA de este bloque se usa (cero red).
# Se deja completo para poder pasar a `real` en el VPS sin editar mas archivos.
FSM_API_BASE_URL=https://apix.grupotvcable.com/rest/fsm-data-api/v1.0
FSM_API_CHANNEL=FSM
FSM_API_TIMEOUT_MS=15000
FSM_API_MAX_CONCURRENCY=4
FSM_API_CACHE_TTL_MS=60000
FSM_STATUS_CACHE_TTL_MS=300000
FSM_STATUS_BATCH_LIMIT=12
FSM_ORDERS_MAX_FANOUT=5
FSM_UNSATISFACTORY_KEYWORDS=insatisfactoria,no conforme,rechazada,reincidencia,reprogramada

# Una sola marca por indicacion de la operadora (2026-09-09).
FSM_BRANDS=telenews
FSM_DEFAULT_BRAND=telenews
FSM_BRAND_STRATEGY=fixed

# Token estatico pegado a mano (vence cada 24 h). Vacio = marca no disponible.
FSM_API_TOKEN_TELENEWS=
FSM_API_TOKEN_SETEINFO=

# Renovacion automatica: si estan URL + KEY, tienen prioridad sobre el token
# estatico y el backend renueva solo. Es la opcion recomendada en el VPS.
FSM_TOKEN_SKEW_MS=60000
FSM_TOKEN_URL_TELENEWS=https://apix.grupotvcable.com/rest/token-api/v1.0/generate
FSM_TOKEN_KEY_TELENEWS=
FSM_TOKEN_URL_SETEINFO=
FSM_TOKEN_KEY_SETEINFO=

# Fuente primaria de NAPs del campo 6 (fsm | tec).
# En la demo: `fsm`, que con CONNECTOR_MODE_FSM=fixture sirve las NAPs reales
# grabadas. Si FSM falla por autenticacion, /naps/nearby CAE AUTOMATICAMENTE a
# TEC y responde 200 con aviso de degradacion (header X-Wifix-Degraded); con TEC
# en mock ese respaldo son datos simulados, que es justo lo que se quiere en una
# demo: la pantalla nunca queda en blanco.
NAPS_PRIMARY_SOURCE=fsm

# ===========================================================================
# ALMACENAMIENTO (MinIO en el mismo compose)
# ===========================================================================
# [compose] Endpoint INTERNO: nombre del servicio, no localhost.
STORAGE_ENDPOINT=http://minio:9000
# Base PUBLICA de las URLs de las fotos que se devuelven a la app. Si se deja
# vacia se usa STORAGE_ENDPOINT, que desde el celular NO resuelve. El reverse
# proxy del VPS debe enrutar esta ruta hacia minio:9000 (path-style).
#   ej. https://demo.wifix.tulpasolutions.com/s3
STORAGE_PUBLIC_BASE_URL=<https://dominio-de-la-demo/s3>
STORAGE_REGION=us-east-1
# [compose] Nombre del bucket y credenciales root de MinIO.
STORAGE_BUCKET=wifix-media
STORAGE_ACCESS_KEY=<usuario-minio>
STORAGE_SECRET_KEY=<contraseña-minio-larga>

# ===========================================================================
# OBSERVABILIDAD Y CORS
# ===========================================================================
LOG_LEVEL=info

# Lista separada por comas, sin espacios.
#   - http://localhost y https://localhost: los manda el WebView de Capacitor
#     (el APK Android). Sin ellos la app empaquetada no puede hablar con la API.
#   - capacitor://localhost: origen de iOS / algunas configuraciones de Android.
#   - el dominio de la demo, si tambien se abre desde un navegador.
# NO usar '*' (desactiva la verificacion de origen).
CORS_ORIGIN=http://localhost,https://localhost,capacitor://localhost,https://<dominio-de-la-demo>
