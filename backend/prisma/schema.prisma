// Esquema Prisma — Módulo Herramientas y Equipos Retirados (Wifix Fase 1).
// Tablas y columnas en snake_case; campos del cliente Prisma en camelCase
// (mapeo con @map / @@map). Identificadores propios: uuid v4.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = []
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===========================================================================
// USUARIOS (Fase 2 — autenticación)
// ===========================================================================

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("users")
}

// ===========================================================================
// ENUMS
// ===========================================================================

enum EquipmentCategory {
  DECODIFICADOR
  DECODIFICADOR_HD
  MTA
  ONU
  ONT
  ROUTER

  @@map("equipment_category")
}

enum EquipmentSerialFieldType {
  SN
  HOST_SN @map("HOST-SN")
  PON_SN  @map("PON-SN")
  GPON_SN @map("GPON-SN")
  D_SN    @map("D-SN")

  @@map("equipment_serial_field_type")
}

enum RemovalReasonCode {
  DANO_FISICO
  NO_ENCIENDE
  PUERTO_DANADO
  EQUIPO_INHIBIDO
  NO_DA_SERVICIO
  NO_SE_APROVISIONA
  EQUIPO_OK_CANCELACION
  OTROS

  @@map("removal_reason_code")
}

enum SpeedtestSource {
  APP             @map("app")
  EXTERNAL_DEVICE @map("external-device")

  @@map("speedtest_source")
}

enum NetworkServerType {
  DNS
  GATEWAY
  CDN
  GENERIC

  @@map("network_server_type")
}

// ===========================================================================
// CATÁLOGOS
// ===========================================================================

model EquipmentModel {
  id              String                   @id @default(uuid()) @db.Uuid
  name            String
  category        EquipmentCategory
  serialFieldType EquipmentSerialFieldType @map("serial_field_type")
  brand           String?
  active          Boolean                  @default(true)

  retiredEquipment RetiredEquipment[]

  @@map("equipment_models")
}

model RemovalReason {
  code      RemovalReasonCode @id
  label     String
  sortOrder Int               @default(0) @map("sort_order")
  active    Boolean           @default(true)

  retiredEquipment RetiredEquipment[]

  @@map("removal_reasons")
}

model SpeedtestServer {
  id        String  @id @default(uuid()) @db.Uuid
  name      String
  host      String
  city      String?
  latitude  Float?
  longitude Float?
  active    Boolean @default(true)

  @@map("speedtest_servers")
}

model NetworkServer {
  id     String            @id @default(uuid()) @db.Uuid
  name   String
  target String
  type   NetworkServerType
  active Boolean           @default(true)

  @@map("network_servers")
}

// ===========================================================================
// MEDIA
// ===========================================================================

model MediaFile {
  id          String   @id @default(uuid()) @db.Uuid
  storageKey  String   @map("storage_key")
  url         String
  contentType String   @map("content_type")
  sizeBytes   Int      @map("size_bytes")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  retiredEquipment RetiredEquipment[]

  @@map("media_files")
}

// ===========================================================================
// TRANSACCIONALES — HERRAMIENTAS
// ===========================================================================

model DistanceMeasurement {
  id             String   @id @default(uuid()) @db.Uuid
  accountNumber  String   @map("account_number")
  clientId       String?  @map("client_id")
  contractId     String?  @map("contract_id")
  visitId        String?  @map("visit_id")
  technicianId   String?  @map("technician_id")
  /// Vínculo con la visita FSM: tarea (`TASK/294328/2026`) u orden
  /// (`ORDER/424900/2026`) donde se tomó el registro. Opcional.
  taskId         String?  @map("task_id")
  distanceMeters Float    @map("distance_meters")
  startLat       Float?   @map("start_lat")
  startLng       Float?   @map("start_lng")
  endLat         Float?   @map("end_lat")
  endLng         Float?   @map("end_lng")
  measuredAt     DateTime @map("measured_at") @db.Timestamptz(6)
  notes          String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([accountNumber])
  @@index([clientId])
  @@index([visitId])
  @@index([accountNumber, taskId])
  @@index([measuredAt])
  @@map("distance_measurements")
}

model Speedtest {
  id                String          @id @default(uuid()) @db.Uuid
  accountNumber     String          @map("account_number")
  clientId          String?         @map("client_id")
  contractId        String?         @map("contract_id")
  visitId           String?         @map("visit_id")
  technicianId      String?         @map("technician_id")
  /// Vínculo con la visita FSM: tarea (`TASK/294328/2026`) u orden
  /// (`ORDER/424900/2026`) donde se tomó el registro. Opcional.
  taskId            String?         @map("task_id")
  downloadMbps      Float           @map("download_mbps")
  uploadMbps        Float           @map("upload_mbps")
  latencyMs         Float?          @map("latency_ms")
  jitterMs          Float?          @map("jitter_ms")
  packetLossPercent Float?          @map("packet_loss_percent")
  serverId          String?         @map("server_id")
  serverName        String?         @map("server_name")
  ispName           String?         @map("isp_name")
  /// Quién midió: la app (`app`) o un dispositivo Android externo del técnico
  /// con puerto de hasta 10 Gb/s (`external-device`).
  source            SpeedtestSource @default(APP)
  deviceName        String?         @map("device_name")
  deviceId          String?         @map("device_id")
  /// `true` si el resultado es simulado (hoy el externo se simula en el frontend).
  simulated         Boolean         @default(false)
  measuredAt        DateTime        @map("measured_at") @db.Timestamptz(6)
  notes             String?
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([accountNumber])
  @@index([clientId])
  @@index([visitId])
  @@index([accountNumber, taskId])
  @@index([measuredAt])
  @@map("speedtests")
}

model WifiHeatmap {
  id            String   @id @default(uuid()) @db.Uuid
  accountNumber String   @map("account_number")
  clientId      String?  @map("client_id")
  contractId    String?  @map("contract_id")
  visitId       String?  @map("visit_id")
  technicianId  String?  @map("technician_id")
  /// Vínculo con la visita FSM: tarea (`TASK/294328/2026`) u orden
  /// (`ORDER/424900/2026`) donde se tomó el registro. Opcional.
  taskId        String?  @map("task_id")
  label         String?
  notes         String?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  rooms     WifiHeatmapRoom[]
  pingTests PingTest[]

  @@index([accountNumber])
  @@index([clientId])
  @@index([visitId])
  @@index([accountNumber, taskId])
  @@index([createdAt])
  @@map("wifi_heatmaps")
}

model WifiHeatmapRoom {
  id           String   @id @default(uuid()) @db.Uuid
  heatmapId    String   @map("heatmap_id") @db.Uuid
  roomName     String   @map("room_name")
  floor        Int      @default(1)
  /// Deprecated. Para multi-AP cada room tiene N entradas en `measurements`.
  /// Sigue presente para retrocompatibilidad de lectura. En lecturas nuevas
  /// el valor "efectivo" es el mejor signalDbm de `measurements`.
  signalDbm    Float?   @map("signal_dbm")
  legacyFormat Boolean  @default(false) @map("legacy_format")
  measuredAt   DateTime @map("measured_at") @db.Timestamptz(6)
  notes        String?

  heatmap      WifiHeatmap         @relation(fields: [heatmapId], references: [id], onDelete: Cascade)
  measurements RoomApMeasurement[]

  @@index([heatmapId])
  @@map("wifi_heatmap_rooms")
}

model WifiAccessPoint {
  id            String   @id @default(uuid()) @db.Uuid
  accountNumber String   @map("account_number")
  bssid         String
  ssid          String?
  label         String
  /// "router" | "extender" | "mesh_node" | "unknown"
  apType        String   @default("unknown") @map("ap_type")
  /// "2.4GHz" | "5GHz" | "6GHz" | "unknown"
  band          String   @default("unknown")
  notes         String?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  measurements RoomApMeasurement[]

  @@unique([accountNumber, bssid])
  @@index([accountNumber])
  @@map("wifi_access_points")
}

model RoomApMeasurement {
  id              String   @id @default(uuid()) @db.Uuid
  roomId          String   @map("room_id") @db.Uuid
  accessPointId   String?  @map("access_point_id") @db.Uuid
  bssid           String
  apLabelSnapshot String?  @map("ap_label_snapshot")
  signalDbm       Float    @map("signal_dbm")
  /// "2.4GHz" | "5GHz" | "6GHz" | "unknown"
  band            String   @default("unknown")
  channel         Int?
  isConnected     Boolean  @default(false) @map("is_connected")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  room        WifiHeatmapRoom  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  accessPoint WifiAccessPoint? @relation(fields: [accessPointId], references: [id], onDelete: SetNull)

  @@index([roomId])
  @@index([accessPointId])
  @@index([bssid])
  @@map("room_ap_measurements")
}

model PingTest {
  id                String   @id @default(uuid()) @db.Uuid
  accountNumber     String   @map("account_number")
  clientId          String?  @map("client_id")
  contractId        String?  @map("contract_id")
  visitId           String?  @map("visit_id")
  technicianId      String?  @map("technician_id")
  /// Vínculo con la visita FSM: tarea (`TASK/294328/2026`) u orden
  /// (`ORDER/424900/2026`) donde se tomó el registro. Opcional.
  taskId            String?  @map("task_id")
  target            String
  serverId          String?  @map("server_id")
  packetsSent       Int?     @map("packets_sent")
  packetsReceived   Int?     @map("packets_received")
  packetLossPercent Float?   @map("packet_loss_percent")
  minLatencyMs      Float?   @map("min_latency_ms")
  avgLatencyMs      Float?   @map("avg_latency_ms")
  maxLatencyMs      Float?   @map("max_latency_ms")
  continuous        Boolean  @default(false)
  heatmapId         String?  @map("heatmap_id") @db.Uuid
  roomName          String?  @map("room_name")
  measuredAt        DateTime @map("measured_at") @db.Timestamptz(6)
  notes             String?
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  heatmap WifiHeatmap? @relation(fields: [heatmapId], references: [id], onDelete: SetNull)

  @@index([accountNumber])
  @@index([clientId])
  @@index([visitId])
  @@index([accountNumber, taskId])
  @@index([measuredAt])
  @@index([heatmapId])
  @@map("ping_tests")
}

model TracerouteTest {
  id            String   @id @default(uuid()) @db.Uuid
  accountNumber String   @map("account_number")
  clientId      String?  @map("client_id")
  contractId    String?  @map("contract_id")
  visitId       String?  @map("visit_id")
  technicianId  String?  @map("technician_id")
  /// Vínculo con la visita FSM: tarea (`TASK/294328/2026`) u orden
  /// (`ORDER/424900/2026`) donde se tomó el registro. Opcional.
  taskId        String?  @map("task_id")
  target        String
  serverId      String?  @map("server_id")
  measuredAt    DateTime @map("measured_at") @db.Timestamptz(6)
  notes         String?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  hops TracerouteHop[]

  @@index([accountNumber])
  @@index([clientId])
  @@index([visitId])
  @@index([accountNumber, taskId])
  @@index([measuredAt])
  @@map("traceroute_tests")
}

model TracerouteHop {
  id               String  @id @default(uuid()) @db.Uuid
  tracerouteTestId String  @map("traceroute_test_id") @db.Uuid
  hopNumber        Int     @map("hop_number")
  host             String?
  latencyMs        Float?  @map("latency_ms")

  tracerouteTest TracerouteTest @relation(fields: [tracerouteTestId], references: [id], onDelete: Cascade)

  @@index([tracerouteTestId])
  @@map("traceroute_hops")
}

// ===========================================================================
// TRANSACCIONALES — EQUIPOS RETIRADOS
// ===========================================================================

model RetiredEquipment {
  id                String                   @id @default(uuid()) @db.Uuid
  accountNumber     String                   @map("account_number")
  clientId          String?                  @map("client_id")
  contractId        String?                  @map("contract_id")
  visitId           String?                  @map("visit_id")
  technicianId      String?                  @map("technician_id")
  /// Vínculo con la visita FSM: tarea (`TASK/294328/2026`) u orden
  /// (`ORDER/424900/2026`) donde se tomó el registro. Opcional.
  taskId            String?                  @map("task_id")
  equipmentModelId  String                   @map("equipment_model_id") @db.Uuid
  serialValue       String                   @map("serial_value")
  serialFieldType   EquipmentSerialFieldType @map("serial_field_type")
  barcodePhotoId    String?                  @map("barcode_photo_id") @db.Uuid
  removalReasonCode RemovalReasonCode        @map("removal_reason_code")
  observations      String?
  retiredAt         DateTime                 @map("retired_at") @db.Timestamptz(6)
  createdAt         DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)

  equipmentModel EquipmentModel @relation(fields: [equipmentModelId], references: [id])
  removalReason  RemovalReason  @relation(fields: [removalReasonCode], references: [code])
  barcodePhoto   MediaFile?     @relation(fields: [barcodePhotoId], references: [id], onDelete: SetNull)

  @@index([accountNumber])
  @@index([clientId])
  @@index([visitId])
  @@index([accountNumber, taskId])
  @@index([serialValue])
  @@index([retiredAt])
  @@map("retired_equipment")
}

// ===========================================================================
// WHITELIST DE CLIENTES (cuentas reales de la operadora)
// ===========================================================================
//
// Lista de cuentas válidas para "Confirmar cuenta". Se REEMPLAZA completa en
// cada import (`prisma/import-whitelist.ts`), a partir de un CSV minimizado que
// se construye en local (`scripts/whitelist-build.ts`).
//
// MINIMIZACIÓN (LOPDP): solo lo imprescindible para validar la cuenta y, desde
// 2026-09-26 (decisión de Franco), el nombre como respaldo de client-profile.
// NADA de dirección, coordenadas ni saldo. `documentId` se guarda para una
// futura verificación cruzada y NUNCA sale en una respuesta de la API.

enum WhitelistStatus {
  ACTIVO
  SUSPENDIDO
  ORDENADO
  PENDIENTE

  @@map("whitelist_status")
}

model CustomerWhitelist {
  /// ACCOUNT_ID normalizado (string, sin ceros a la izquierda si es numérico).
  accountNumber      String          @id @map("account_number")
  /// Cédula (10) / RUC (13) con el cero inicial restituido. Nunca se expone.
  documentId         String          @map("document_id")
  /// `false` si el documento no pudo llevarse a 10/13 dígitos (se guarda tal cual).
  documentNormalized Boolean         @map("document_normalized")
  cpartyId           String?         @map("cparty_id")
  status             WhitelistStatus
  city               String?
  node               String?
  businessType       String?         @map("business_type")
  accountType        String?         @map("account_type")
  accessType         String?         @map("access_type")
  /// FULLNAME de la planilla. Solo respaldo de client-profile cuando FSM no
  /// trae identidad; la ruta /accounts/:n/whitelist NO lo expone.
  fullName           String?         @map("full_name")
  importedAt         DateTime        @map("imported_at") @db.Timestamptz(6)

  @@index([documentId])
  @@map("customer_whitelist")
}

model WhitelistImport {
  id          String   @id @default(uuid()) @db.Uuid
  importedAt  DateTime @default(now()) @map("imported_at") @db.Timestamptz(6)
  /// Nombres (sin ruta) de los archivos de origen.
  sourceFiles String[] @map("source_files")
  /// Filas de datos leídas del CSV.
  rows        Int
  /// Cuentas insertadas.
  accounts    Int
  /// Conteo por estado: { "ACTIVO": n, "SUSPENDIDO": n, ... }
  byStatus    Json     @map("by_status")

  @@index([importedAt])
  @@map("whitelist_imports")
}

// ===========================================================================
// UBICACIÓN "CASA CLIENTE" (GPS del técnico en el domicilio)
// ===========================================================================
//
// APPEND-ONLY: cada captura es una fila nueva; nunca se sobrescribe. Sirve para
// que un gerente compare la ubicación capturada por el técnico con la que la
// operadora tiene registrada del cliente y ubique la casa exacta.
//
// Las columnas `registered_*`, `nap_*` y `distance_*` son una FOTO tomada al
// capturar (la ubicación registrada o la NAP pueden cambiar después): leer el
// historial no requiere llamar a FSM.

enum ClientLocationLabel {
  CASA_CLIENTE

  @@map("client_location_label")
}

enum ClientLocationSource {
  GPS
  MANUAL

  @@map("client_location_source")
}

model ClientLocation {
  id                         String               @id @default(uuid()) @db.Uuid
  accountNumber              String               @map("account_number")
  label                      ClientLocationLabel  @default(CASA_CLIENTE)
  latitude                   Float
  longitude                  Float
  accuracyMeters             Float?               @map("accuracy_meters")
  source                     ClientLocationSource
  /// NAP del cliente a la que se vincula la captura (la enviada o la de current-nap).
  napCode                    String?              @map("nap_code")
  napPort                    String?              @map("nap_port")
  /// Coordenada de la NAP según current-nap al capturar; null si no coincide el código.
  napLatitude                Float?               @map("nap_latitude")
  napLongitude               Float?               @map("nap_longitude")
  /// true si esa NAP era la asignada SIMULADA de current-nap.
  napSimulated               Boolean?             @map("nap_simulated")
  /// Vínculo con la visita FSM (`TASK/…` u `ORDER/…`). Opcional.
  taskId                     String?              @map("task_id")
  capturedAt                 DateTime             @map("captured_at") @db.Timestamptz(6)
  notes                      String?
  /// Usuario (técnico) que capturó: id del JWT y email como foto.
  capturedById               String               @map("captured_by_id")
  capturedByEmail            String               @map("captured_by_email")
  /// Ubicación registrada del cliente al capturar ('FSM' | 'TEC' | 'MOCK').
  registeredLatitude         Float?               @map("registered_latitude")
  registeredLongitude        Float?               @map("registered_longitude")
  registeredSource           String?              @map("registered_source")
  distanceToRegisteredMeters Float?               @map("distance_to_registered_meters")
  distanceToNapMeters        Float?               @map("distance_to_nap_meters")
  createdAt                  DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([accountNumber, capturedAt])
  @@index([accountNumber, taskId])
  @@index([capturedAt])
  @@map("client_locations")
}
