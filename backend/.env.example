# Entorno de ejecución (development | production)
NODE_ENV=development

# Puerto HTTP del servidor Fastify
PORT=8080

# Cadena de conexión PostgreSQL
DATABASE_URL=postgresql://wifix:wifix@localhost:5433/wifix_tools?schema=public

# Autenticación (Fase 2)
JWT_SECRET=cambia-este-secreto-en-prod-min-32-caracteres-y-bien-aleatorio
JWT_EXPIRES_IN=12h
SEED_USER_EMAIL=franco@tulpasolutions.com
SEED_USER_PASSWORD=wifix-dev-2026
SEED_USER_NAME=Franco Ceruso

# Capa de conectores externos: mock | real
CONNECTOR_MODE=mock
# Comarch, ACS y RMS siguen en mock (sin credenciales todavia).
# TEC e ISP Monitor ya tienen accesos reales:
CONNECTOR_MODE_TEC=real
CONNECTOR_MODE_ISPMONITOR=real
# FSM: mock hasta que haya un token vigente de la operadora (ver bloque FSM).
CONNECTOR_MODE_FSM=mock

# --- API de TEC / ISP Monitor (Grupo TVCable) ---
# Autenticacion HTTP Digest. Obligatorias cuando CONNECTOR_MODE=real.
TEC_API_BASE_URL=https://tec-api.grupotvcable.com
TEC_API_USERNAME=
TEC_API_PASSWORD=
TEC_API_TIMEOUT_MS=15000
# Cuidado del upstream: la operadora no publica un tope de peticiones, pero
# pidio no consultar de mas y NO hay ambiente de pruebas (todo es produccion).
# Peticiones simultaneas maximas hacia la operadora (el resto espera en cola).
TEC_API_MAX_CONCURRENCY=4
# Cache de respuestas por endpoint+id. Las series se refrescan cada 5 min, asi
# que repetir la consulta dentro de la ventana no vuelve a salir a la red.
TEC_API_CACHE_TTL_MS=60000


# --- FSM (fsm-data-ms, Grupo TVCable) ---
# Microservicio de ordenes, tareas, NAPs GPON y estado de cuenta.
# Autenticacion Bearer POR MARCA (cada marca es un realm de Keycloak).
# A diferencia de TEC, si falta el token el servidor ARRANCA IGUAL: solo avisa
# por consola y las rutas de FSM responden 503 UPSTREAM_AUTH_ERROR. El token
# vence cada 24 h y no puede tumbar Herramientas ni Equipos Retirados.
FSM_API_BASE_URL=https://apix.grupotvcable.com/rest/fsm-data-api/v1.0
FSM_API_CHANNEL=FSM
FSM_API_TIMEOUT_MS=15000
# Semaforo propio, separado del de TEC (son dos hosts distintos).
FSM_API_MAX_CONCURRENCY=4
FSM_API_CACHE_TTL_MS=60000
# El estado de una cuenta no cambia minuto a minuto: cache mas largo.
FSM_STATUS_CACHE_TTL_MS=300000
# Tope de cuentas por lote en POST /accounts/status-batch (campo 8, paso 2).
FSM_STATUS_BATCH_LIMIT=12
# Ordenes finalizadas mas recientes cuyas notas se leen para el campo 15.
FSM_ORDERS_MAX_FANOUT=5
# Heuristico PROVISIONAL para marcar una tarea como INSATISFACTORIA: se aplica
# al status y al contenido de las notas, sin acentos ni mayusculas.
# Debe recalibrarse con la salida real de scripts/probe-fsm-api.ts.
FSM_UNSATISFACTORY_KEYWORDS=insatisfactoria,no conforme,rechazada,reincidencia,reprogramada

# Marcas / realms. La marca por defecto se usa si la peticion no manda
# el header X-Wifix-Brand (ni ?brand=).
# INDICACION OFICIAL DE LA OPERADORA (2026-09-09): usar SOLO telenews
# (realm-ecommerce-callcenter-telenews), que contiene TODA la base de clientes.
# seteinfo queda DESHABILITADA; para reactivarla basta con listarla aqui
# (FSM_BRANDS=telenews,seteinfo): la plomeria multi-marca sigue intacta.
FSM_BRANDS=telenews
FSM_DEFAULT_BRAND=telenews
# probe (probar ambas marcas) esta APAGADO por defecto: duplicaria las
# consultas a produccion. Ver ADR-01.
FSM_BRAND_STRATEGY=fixed

# Token estatico (24 h, pegado a mano). Vacio = la marca no esta disponible.
# Rotacion: pegar el token nuevo aqui y reiniciar el servicio. Verificar con
#   npx tsx scripts/probe-fsm-api.ts token     (no sale a la red)
FSM_API_TOKEN_TELENEWS=
FSM_API_TOKEN_SETEINFO=

# Renovacion automatica del token (confirmada por la operadora el 2026-09-09).
# NO es OAuth client_credentials: es un protocolo propio del API manager.
#   POST <FSM_TOKEN_URL_*>  Content-Type: application/json
#   { "channel": "telenews", "key": "<FSM_TOKEN_KEY_*>",
#     "realm": "realm-ecommerce-callcenter-telenews", "type": "Basic" }
#   -> { "token": "<jwt>", "expiryTime": 86400 }
# Si estan URL + KEY de una marca, tienen prioridad sobre el token estatico.
# FSM_TOKEN_KEY_* es la credencial Basic en base64 (usuario:secreto): la entrega
# el contacto de la operadora (Grupo TVCable) junto con el alta del canal.
# NUNCA se commitea: va solo en el .env del servidor (que esta en .gitignore).
FSM_TOKEN_SKEW_MS=60000
FSM_TOKEN_URL_TELENEWS=https://apix.grupotvcable.com/rest/token-api/v1.0/generate
FSM_TOKEN_KEY_TELENEWS=
# seteinfo deshabilitada por indicacion de la operadora (2026-09-09).
FSM_TOKEN_URL_SETEINFO=
FSM_TOKEN_KEY_SETEINFO=

# Fuente primaria de NAPs del campo 6 (ver ADR-04): fsm | tec.
# Hoy: tec (es lo que ya funciona en produccion). Se cambia a fsm cuando haya
# token; si FSM falla por autenticacion, /naps/nearby cae a TEC solo.
NAPS_PRIMARY_SOURCE=tec


# Almacenamiento S3-compatible (MinIO en local)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=wifix-media
STORAGE_ACCESS_KEY=wifixminio
STORAGE_SECRET_KEY=wifixminio123

# Nivel de log de pino (trace | debug | info | warn | error | fatal)
LOG_LEVEL=info

# Orígenes permitidos para CORS — lista separada por comas (sin espacios entre ellos).
# Ejemplo producción: https://app.wifix.com,https://otra.wifix.app
# El valor especial '*' desactiva la verificación de origen (solo desarrollo local).
CORS_ORIGIN=http://localhost:5173
